# Supabase (Project Settings, API). La clave publishable puede ir en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps JavaScript API (clave restringida por dominio). Sin clave se usa el mapa dibujado.
VITE_GOOGLE_MAPS_API_KEY=

# ID de cliente OAuth web de Google (solo informativo: el login va por Supabase Auth).
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Map ID vectorial de Google Cloud (estilo en la nube). Sin el se usa DEMO_MAP_ID para el modo 3D.
VITE_GOOGLE_MAP_ID=
