// Copia como Secrets.xcconfig (gitignored). En xcconfig "//" es comentario: escribe las URL con https:/$()/
SUPABASE_URL = https:/$()/TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY = eyJ...
GOOGLE_WEB_CLIENT_ID = 1234-abc.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID = 1234-xyz.apps.googleusercontent.com
// Client ID iOS al revés (URL scheme de Google Sign-In):
GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.1234-xyz
