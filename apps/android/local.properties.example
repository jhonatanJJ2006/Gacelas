# Configuracion local de Android. NO subir este archivo al repositorio.
# Copia este archivo como local.properties y llena los valores.

sdk.dir=
# El mapa usa MapLibre con teselas de OpenStreetMap (OpenFreeMap): no necesita clave.
# Supabase (Project Settings, API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ID del cliente OAuth de tipo "Aplicacion web" (el mismo que esta en Supabase). Sin el, el boton de Google avisa.
GOOGLE_WEB_CLIENT_ID=
