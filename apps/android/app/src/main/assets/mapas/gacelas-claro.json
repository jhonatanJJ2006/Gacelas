{
  "version": 8,
  "name": "Gacelas claro",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors, OpenFreeMap"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "fondo",
      "type": "background",
      "paint": {
        "background-color": "#f3f4f6"
      }
    },
    {
      "id": "agua",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#bfdbfe"
      }
    },
    {
      "id": "parques",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d1fae5"
      }
    },
    {
      "id": "verde",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "wood"],
      "paint": {
        "fill-color": "#d1fae5",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "urbano",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "residential", "commercial", "industrial"],
      "paint": {
        "fill-color": "#eceef2"
      }
    },
    {
      "id": "edificios",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-color": "#e2e5ea",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "rios",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#bfdbfe",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 18, 6]
      }
    },
    {
      "id": "senderos",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "path", "track"],
      "paint": {
        "line-color": "#9ca3af",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.8, 20, 4],
        "line-dasharray": [2, 1.5]
      }
    },
    {
      "id": "vias-borde",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "minor",
        "service",
        "tertiary",
        "secondary",
        "primary",
        "trunk",
        "motorway"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f3f4f6",
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 12, 2, 20, 34]
      }
    },
    {
      "id": "vias",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "tertiary"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 12, 1, 20, 28]
      }
    },
    {
      "id": "avenidas",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "primary", "trunk", "motorway"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#e5e7eb",
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 10, 1.5, 20, 32]
      }
    },
    {
      "id": "nombres-vias",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#6b7280",
        "text-halo-color": "#f3f4f6",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "lugares",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "suburb", "neighbourhood"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:es"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 11, 16, 15]
      },
      "paint": {
        "text-color": "#374151",
        "text-halo-color": "#f3f4f6",
        "text-halo-width": 2
      }
    }
  ]
}
