{
  "name": "gacelas-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Gacelas - Aplicación de running con seguimiento en tiempo real",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:docs": "node scripts/lint-docs.js",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test:unit": "turbo run test:unit",
    "type-check": "turbo run type-check",
    "arch": "turbo run arch"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "author": "Jhonatan Jara",
  "repository": {
    "type": "git",
    "url": "https://github.com/[usuario]/gacelas"
  }
}
