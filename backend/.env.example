# Proyecto Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key: nunca en la web ni en Android.
SUPABASE_SERVICE_ROLE_KEY=

# Token personal (Account, Access Tokens) para aplicar migraciones con la Management API.
SUPABASE_ACCESS_TOKEN=

# Cadena de conexion directa (Session pooler). Opcional: el puerto 5432 puede estar bloqueado.
DATABASE_URL=

# Cliente OAuth web de Google (el secreto se pega tambien en Supabase, Auth, Providers, Google).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Maps (geocodificacion en servidor, si se necesita)
GOOGLE_MAPS_API_KEY=
